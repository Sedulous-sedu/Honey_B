# Copy this to .env and fill in the Ground Control server IP.
# Leave VITE_GROUND_URL empty (or delete it) to run in standalone mock mode.

# Ground Control server address (the machine running server/app/main.py on port 8000)
VITE_GROUND_URL=http://192.168.x.x:8000

# Aircraft to track — must match a callsign in the Ground Control server
VITE_FLIGHT_ID=UAE231
