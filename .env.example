# ==============================================================================
# HONEY B GROUND CONTROL & PILOT ADVISORY SYSTEM
# Environment Configuration (.env.example)
# Zero-cost, free-first deployment configuration
# ==============================================================================

# Backend Server Host & Port
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Operational Mode on Startup: LIVE_OBSERVE | REPLAY | WHAT_IF | FIXTURE_SIMULATION
DATA_MODE=LIVE_OBSERVE

# NOAA AviationWeather.gov Endpoint & Interval (Seconds)
NOAA_METAR_URL=https://aviationweather.gov/api/data/metar
NOAA_TAF_URL=https://aviationweather.gov/api/data/taf
NOAA_METAR_INTERVAL_SEC=60
NOAA_TAF_INTERVAL_SEC=600
WEATHER_STATIONS=OMDB,OMDW,OMSJ,OMAA,OMRK

# adsb.lol Transponder Feed Endpoint & Radius (NM around OMDB: 25.2532°N, 55.3657°E)
ADSB_LOL_POINT_URL=https://api.adsb.lol/v2/point
OMDB_LAT=25.2532
OMDB_LON=55.3657
ADSB_RADIUS_NM=100
ADSB_POLL_INTERVAL_SEC=5
ADSB_TRACK_STALE_SEC=30
ADSB_TRACK_EVICT_SEC=120

# Frontend Configuration
VITE_GROUND_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
VITE_FLIGHT_ID=UAE231

