{
  "$defs": {
    "FlightCategory": {
      "enum": [
        "VFR",
        "MVFR",
        "IFR",
        "LIFR"
      ],
      "title": "FlightCategory",
      "type": "string"
    },
    "LvpApproach": {
      "enum": [
        "CAT_I",
        "CAT_II",
        "CAT_IIIA",
        "CAT_IIIB"
      ],
      "title": "LvpApproach",
      "type": "string"
    },
    "LvpInfo": {
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "phase": {
          "$ref": "#/$defs/LvpPhase"
        }
      },
      "required": [
        "active",
        "phase"
      ],
      "title": "LvpInfo",
      "type": "object"
    },
    "LvpPhase": {
      "enum": [
        "NONE",
        "LVP_PREPARATION",
        "LVP_ACTIVE",
        "LVP_CANCELLED"
      ],
      "title": "LvpPhase",
      "type": "string"
    },
    "Provenance": {
      "enum": [
        "AUTHORITATIVE",
        "SIMULATED",
        "PILOT_REPORTED",
        "RULE_BASED",
        "AI_DERIVED",
        "DEMO_ASSUMPTION"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "RunwayMode": {
      "enum": [
        "ARRIVAL",
        "DEPARTURE",
        "MIXED",
        "CLOSED"
      ],
      "title": "RunwayMode",
      "type": "string"
    },
    "RunwayOperationalState": {
      "properties": {
        "runway": {
          "title": "Runway",
          "type": "string"
        },
        "serviceable": {
          "default": true,
          "title": "Serviceable",
          "type": "boolean"
        },
        "status": {
          "$ref": "#/$defs/RunwayOperationalStatus",
          "default": "OPEN"
        },
        "mode": {
          "$ref": "#/$defs/RunwayMode",
          "default": "MIXED"
        },
        "ilsCategory": {
          "$ref": "#/$defs/LvpApproach",
          "default": "CAT_IIIB"
        },
        "smrServiceable": {
          "default": true,
          "title": "Smrserviceable",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "observedAtUtc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observedatutc"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance",
          "default": "AUTHORITATIVE"
        }
      },
      "required": [
        "runway"
      ],
      "title": "RunwayOperationalState",
      "type": "object"
    },
    "RunwayOperationalStatus": {
      "enum": [
        "OPEN",
        "CLOSED",
        "LVO_DEDICATED_DEPARTURE",
        "RESTRICTED"
      ],
      "title": "RunwayOperationalStatus",
      "type": "string"
    },
    "RvrItem": {
      "properties": {
        "runway": {
          "title": "Runway",
          "type": "string"
        },
        "valueM": {
          "title": "Valuem",
          "type": "number"
        },
        "trend": {
          "default": "NO_CHANGE",
          "title": "Trend",
          "type": "string"
        }
      },
      "required": [
        "runway",
        "valueM"
      ],
      "title": "RvrItem",
      "type": "object"
    },
    "Wind": {
      "properties": {
        "directionDeg": {
          "title": "Directiondeg",
          "type": "number"
        },
        "speedKt": {
          "title": "Speedkt",
          "type": "number"
        }
      },
      "required": [
        "directionDeg",
        "speedKt"
      ],
      "title": "Wind",
      "type": "object"
    }
  },
  "properties": {
    "airport": {
      "default": "OMDB",
      "title": "Airport",
      "type": "string"
    },
    "observedAt": {
      "title": "Observedat",
      "type": "string"
    },
    "rawMetar": {
      "title": "Rawmetar",
      "type": "string"
    },
    "visibilityM": {
      "title": "Visibilitym",
      "type": "number"
    },
    "rvr": {
      "items": {
        "$ref": "#/$defs/RvrItem"
      },
      "title": "Rvr",
      "type": "array"
    },
    "ceilingFt": {
      "title": "Ceilingft",
      "type": "number"
    },
    "wind": {
      "$ref": "#/$defs/Wind"
    },
    "temperatureC": {
      "title": "Temperaturec",
      "type": "number"
    },
    "qnhHpa": {
      "title": "Qnhhpa",
      "type": "number"
    },
    "flightCategory": {
      "$ref": "#/$defs/FlightCategory"
    },
    "lvp": {
      "$ref": "#/$defs/LvpInfo"
    },
    "smrServiceable": {
      "default": true,
      "title": "Smrserviceable",
      "type": "boolean"
    },
    "runwayStates": {
      "additionalProperties": {
        "$ref": "#/$defs/RunwayOperationalState"
      },
      "title": "Runwaystates",
      "type": "object"
    },
    "dataFreshnessSec": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": 0.0,
      "title": "Datafreshnesssec"
    },
    "missingDataReasons": {
      "items": {
        "type": "string"
      },
      "title": "Missingdatareasons",
      "type": "array"
    },
    "alerts": {
      "items": {
        "type": "string"
      },
      "title": "Alerts",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance",
      "default": "SIMULATED"
    }
  },
  "required": [
    "observedAt",
    "rawMetar",
    "visibilityM",
    "rvr",
    "ceilingFt",
    "wind",
    "temperatureC",
    "qnhHpa",
    "flightCategory",
    "lvp"
  ],
  "title": "WeatherPayload",
  "type": "object"
}